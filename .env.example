# Токен з https://api.monobank.ua/ (вхід через QR у застосунку моно)
MONO_TOKEN=
# Скільки днів історії тягнути при першій синхронізації
MONO_BACKFILL_DAYS=365
# Як часто фоново оновлювати моно, поки працює сервер
MONO_SYNC_HOURS=6

# Токен для імпорту бази в мобільну апку
EXPORT_TOKEN=

# Особисті правила категорій (номери власних карток не живуть у git), JSON:
# [{"pattern":"<regex по опису операції>","category":"<категорія>"}]
# Для телефона — те саме в mobile/.env як EXPO_PUBLIC_PERSONAL_CATEGORY_RULES.
PERSONAL_CATEGORY_RULES=
