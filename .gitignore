# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# локальна база і банківські файли — НЕ комітити
/data/
/imports/

# локальні налаштування Claude Code
/.claude/settings.local.json

# снапшоти регресії містять особисті суми — тільки локально
/tests/regression/__snapshots__

# мій реальний бюджет і баланси бонусів — тільки локально
/scripts/seed-bonuses.ts
/scripts/seed-budgets.ts
/.claude/

# ключі підпису Android
*.keystore
*.jks
/mobile/credentials/

# old Expo-generated repo of mobile/ (kept locally)
/.nested-git-backup/

# Gradle build output of local native modules
/mobile/modules/*/android/build/
/mobile/modules/*/android/.gradle/
